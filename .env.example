# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Database
DATABASE_URL=postgresql://shopcore:shopcore@localhost:5432/shopcore
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Store
STORE_CURRENCY=USD
ORDER_PAYMENT_TTL_MINUTES=30

# Stripe (test keys only — live keys are rejected at boot)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_SUPPRESS_NOTICES=true

# Cloudflare R2
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=shopcore-dev
R2_PUBLIC_BASE_URL=https://shopcore-cdn.example.com
UPLOAD_MAX_BYTES=5242880
UPLOAD_DAILY_QUOTA=20

# Rate limiting
THROTTLE_GLOBAL_LIMIT=120

# Email (empty RESEND_API_KEY = log only)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ALLOWLIST=

# Demo
DEMO_MODE=true
