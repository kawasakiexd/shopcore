{
  "name": "shopcore-api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:validate": "prisma validate",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:studio": "prisma studio",
    "seed:images:generate": "tsx scripts/generate-seed-images.ts",
    "seed:images:upload": "tsx scripts/upload-seed-images.ts",
    "demo:reset": "tsx src/cli/demo-reset.cli.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/v1/payments/stripe/webhook"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.33.0",
    "rxjs": "^7.8.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.0",
    "sharp": "^0.35.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
